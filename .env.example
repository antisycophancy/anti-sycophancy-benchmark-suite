# SUS Unified Benchmark Suite local secrets template.
#
# Copy to `.env` in this directory for local use. The real `.env` file is
# ignored by git. Leave unused providers blank; blank values are ignored by the
# suite env loader so module-level placeholders do not shadow root keys.

# Current default route for published-style paid runs.
OPENROUTER_API_KEY=

# Direct provider keys. These are optional unless a model endpoint in
# suite_models.yaml references the matching api_key_env. Anthropic native is
# currently wired for SUS; OpenAI-compatible direct endpoints can be added in
# suite_models.yaml as needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# Optional provider-neutral local OpenAI-compatible endpoint from
# public suite_models.yaml. When exposing the reference adapter beyond
# localhost, set ADAPTER_INBOUND_API_KEY to the same value.
LOCAL_OPENAI_COMPATIBLE_API_KEY=
ADAPTER_INBOUND_API_KEY=

# Private overlays may reference additional service keys for an ignored local
# adapter or any other OpenAI-compatible served endpoint.
PRIVATE_ADAPTER_API_KEY=

# Local paid-call coordination. The scheduler also forwards these into child
# benchmark processes when --max-active-calls is used.
BENCHMARK_PAID_CALL_MAX_ACTIVE=3
BENCHMARK_RATE_LIMIT_COOLDOWN_SECONDS=30
BENCHMARK_RATE_LIMIT_MAX_COOLDOWN_SECONDS=300
