# Provider-neutral reference adapter
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=9999
EXPOSED_MODEL_ID=local/example-model
# Reject requests larger than 1 MiB before JSON validation.
ADAPTER_MAX_REQUEST_BYTES=1048576

# Inbound bearer auth. It may be blank only for loopback deterministic reference
# mode. Any upstream proxy mode or non-loopback bind requires a value matching
# LOCAL_OPENAI_COMPATIBLE_API_KEY in the suite .env.
ADAPTER_INBOUND_API_KEY=

# Include truncated raw upstream detail in the HTTP error and local logs. Leave
# false for normal use because upstream bodies can contain private data.
ADAPTER_DEBUG_UPSTREAM_ERRORS=false

# Private adapter-authored error journal. It never enters the HTTP response or
# benchmark evidence bundle. Blank disables it. Detail capture is opt-in because
# upstream error text can contain private data.
ADAPTER_DIAGNOSTICS_PATH=results/adapter-diagnostics.jsonl
ADAPTER_DIAGNOSTICS_INCLUDE_DETAIL=false
ADAPTER_DIAGNOSTICS_MAX_BYTES=16777216

# Optional upstream OpenAI-compatible proxy mode.
# Leave unset for deterministic local smoke responses.
UPSTREAM_OPENAI_BASE_URL=
UPSTREAM_CHAT_COMPLETIONS_URL=
# Blank forwards the benchmark-requested model id. Set this when the public
# adapter model id differs from the private/upstream model id.
UPSTREAM_MODEL_ID=
UPSTREAM_API_KEY_ENV=
UPSTREAM_API_KEY=
REQUEST_TIMEOUT_SECONDS=120

# Optional deterministic response used when no upstream is configured.
REFERENCE_RESPONSE=Reference OpenAI-compatible adapter response.
